{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "islandsurvival",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ISLAND",
        "class_name": "IslandState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "IslandState"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "keep_vars": true
}
